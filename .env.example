# Local/CI contract testing only. Docker and production workflows force this off
# until the portfolio canary has passed its 24-48 hour acceptance gate.
PUBLIC_BROWSER_OBSERVABILITY_ENABLED=false
PUBLIC_BROWSER_OBSERVABILITY_URL=https://otel.theunreliable.engineer
# Public and non-authenticating. Never put a ClickStack server key here.
PUBLIC_BROWSER_OBSERVABILITY_API_KEY=browser-public
PUBLIC_BROWSER_SERVICE_NAME=the-unreliable-engineer-frontend
PUBLIC_BROWSER_SERVICE_VERSION=local
PUBLIC_BROWSER_SITE_NAME=theunreliable.engineer
PUBLIC_DEPLOYMENT_ENVIRONMENT=production
