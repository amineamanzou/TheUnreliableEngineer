---
import "../styles/global.css";
import type { Locale } from "../data/i18n";
import { assetPath, localizedPath } from "../data/i18n";
import {
  absoluteUrl,
  defaultSocialImageAlt,
  localeToOgLocale,
  type JsonLd,
} from "../data/seo";
import { defaultSocialImage } from "../data/site";

type Props = {
  title: string;
  description: string;
  locale?: Locale;
  lang?: Locale;
  canonicalPath?: string;
  alternates?: Array<{ locale: Locale; path: string }>;
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "article";
  publishedAt?: string;
  modifiedAt?: string;
  jsonLd?: JsonLd;
  noindex?: boolean;
  enableLocaleRedirect?: boolean;
  localeRedirectPath?: string;
  localeRedirectPaths?: { fr: string; en: string };
  bodyClass?: string;
};

const {
  title,
  description,
  locale,
  lang,
  canonicalPath,
  alternates = [],
  image = defaultSocialImage,
  imageAlt = defaultSocialImageAlt,
  ogType = "website",
  publishedAt,
  modifiedAt,
  jsonLd,
  noindex = false,
  enableLocaleRedirect = false,
  localeRedirectPath = "/",
  localeRedirectPaths,
  bodyClass,
} = Astro.props;
const pageLocale = locale ?? lang ?? "fr";
const canonicalUrl = canonicalPath && Astro.site ? new URL(assetPath(canonicalPath), Astro.site).toString() : undefined;
const pageUrl = canonicalUrl ?? Astro.url.toString();
const socialImageUrl = absoluteUrl(image, Astro.site);
const alternateLinks = Astro.site
  ? alternates.map((alternate) => ({
      locale: alternate.locale,
      href: new URL(assetPath(alternate.path), Astro.site).toString(),
    }))
  : [];
const ogAlternateLocales = alternates
  .map((alternate) => alternate.locale)
  .filter((alternateLocale) => alternateLocale !== pageLocale)
  .map(localeToOgLocale);
const baseUrl = import.meta.env.BASE_URL;
const isPreviewBuild = baseUrl !== "/" || Astro.site?.hostname.endsWith("github.io");
const robotsContent = noindex || isPreviewBuild ? "noindex,follow" : undefined;
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replaceAll("<", "\\u003c") : undefined;
const redirectPathFr = assetPath(localeRedirectPaths?.fr ?? localizedPath("fr", localeRedirectPath));
const redirectPathEn = assetPath(localeRedirectPaths?.en ?? localizedPath("en", localeRedirectPath));
const xDefaultPath =
  alternates.find((alternate) => alternate.locale === "fr")?.path ?? canonicalPath ?? "/";
---

<!doctype html>
<html lang={pageLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternateLinks.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />)}
    {alternateLinks.length > 0 && Astro.site && <link rel="alternate" hreflang="x-default" href={new URL(assetPath(xDefaultPath), Astro.site).toString()} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={localeToOgLocale(pageLocale)} />
    {ogAlternateLocales.map((alternateLocale) => <meta property="og:locale:alternate" content={alternateLocale} />)}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body class={bodyClass}>
    {
      enableLocaleRedirect && (
        <script is:inline define:vars={{ baseUrl, redirectPathFr, redirectPathEn }}>
          const relativePath = window.location.pathname.startsWith(baseUrl)
            ? window.location.pathname.slice(baseUrl.length - 1)
            : window.location.pathname;
          const preferredLocale = window.localStorage.getItem("preferredLocale");
          const browserLocales = navigator.languages ?? [navigator.language ?? "fr"];
          const preferredSupportedLocale = browserLocales
            .map((value) => String(value).toLowerCase())
            .map((value) => (value.startsWith("en") ? "en" : value.startsWith("fr") ? "fr" : null))
            .find(Boolean);

          if (!preferredLocale && relativePath === redirectPathFr.replace(baseUrl, "/") && preferredSupportedLocale === "en") {
            window.location.replace(`${redirectPathEn}${window.location.hash}`);
          }
        </script>
      )
    }
    <slot />
  </body>
</html>
