---
import type { Locale } from "../data/i18n";
import { assetPath, localizedPath } from "../data/i18n";

type Props = {
  locale: Locale;
  observabilityEnabled?: boolean;
  productAnalyticsEnabled?: boolean;
};

const { locale, observabilityEnabled = false, productAnalyticsEnabled = false } = Astro.props;
const homeHref = assetPath(localizedPath(locale, "/"));
const privacyHref = assetPath(locale === "fr" ? "/confidentialite/" : "/en/privacy/");
const termsHref = assetPath(locale === "fr" ? "/conditions-utilisation/" : "/en/terms/");
const deletionHref = assetPath(locale === "fr" ? "/suppression-des-donnees/" : "/en/data-deletion/");
const copy = locale === "fr"
  ? { privacy: "Confidentialité", terms: "Conditions", deletion: "Suppression des données", manage: "Gérer la mesure", home: "Accueil" }
  : { privacy: "Privacy", terms: "Terms", deletion: "Data deletion", manage: "Manage measurement", home: "Home" };
---

<footer class="site-footer">
  <div class="shell shell-wide site-footer-inner">
    <div>
      <strong>The Unreliable Engineer</strong>
      <span>© {new Date().getFullYear()} Amine Amanzou</span>
    </div>
    <nav aria-label={locale === "fr" ? "Liens de pied de page" : "Footer links"}>
      <a href={homeHref}>{copy.home}</a>
      <a href={privacyHref}>{copy.privacy}</a>
      <a href={termsHref}>{copy.terms}</a>
      <a href={deletionHref}>{copy.deletion}</a>
      {observabilityEnabled && <button type="button" data-open-rum-settings>{copy.manage}</button>}
      {productAnalyticsEnabled && <button type="button" data-open-analytics-settings>Analytics</button>}
    </nav>
  </div>
</footer>
