---
type Props = {
  src?: string;
  sources?: Array<{ src: string; width: number }>;
  sizes?: string;
  width?: number;
  height?: number;
  alt?: string;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
};

const {
  src = "/brand/web/characters/pointing_up.png",
  sources,
  sizes,
  width,
  height,
  alt = "The Unreliable Engineer",
  class: className = "",
  loading = "lazy",
  fetchpriority = "auto",
} = Astro.props;

const resolvedSrc = src.startsWith("/") ? `${import.meta.env.BASE_URL}${src.slice(1)}` : src;
const resolvedSrcset = sources
  ?.map(({ src: source, width: sourceWidth }) => {
    const resolvedSource = source.startsWith("/")
      ? `${import.meta.env.BASE_URL}${source.slice(1)}`
      : source;
    return `${resolvedSource} ${sourceWidth}w`;
  })
  .join(", ");
---

<img
  class:list={["character-asset", className]}
  src={resolvedSrc}
  srcset={resolvedSrcset}
  sizes={sizes}
  width={width}
  height={height}
  alt={alt}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
/>
